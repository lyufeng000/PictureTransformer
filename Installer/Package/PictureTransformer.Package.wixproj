<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>PictureTransformer</OutputName>
    <Platform>x64</Platform>
    <DefineConstants>PublishDir=$(MSBuildThisFileDirectory)..\..\bin</DefineConstants>
    <SuppressIces>ICE38;ICE64;ICE91</SuppressIces>
  </PropertyGroup>
</Project>
