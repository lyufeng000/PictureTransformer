<Window x:Class="PictureTransformer.SetupUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PictureTransformer 安装程序"
        Icon="Resources/png.ico"
        Width="780"
        Height="570"
        MinWidth="680"
        MinHeight="470"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#FFF9F9F9"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="16">
    <Grid Margin="30,24,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="PictureTransformer" FontSize="30" FontWeight="Normal" />

        <Grid x:Name="InstallPanel" Grid.Row="1" Margin="0,58,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="欢迎" FontSize="36" Foreground="#FF666666" />
            <TextBlock Grid.Row="1" Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="请选择父文件夹。安装程序会在输入框中补全 PictureTransformer，并安装到显示的完整路径。" />
            <TextBlock Grid.Row="2" Margin="0,30,0,8" Text="完整安装目录：" />
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InstallPathTextBox" Height="36" Padding="8,4" VerticalContentAlignment="Center" />
                <Button x:Name="BrowseButton" Grid.Column="2" Height="36" Content="浏览" Click="BrowseButton_Click" />
            </Grid>
            <CheckBox x:Name="AddToPathCheckBox" Grid.Row="4" Margin="0,18,0,0" VerticalAlignment="Top"
                      IsChecked="True" Content="将命令行工具加入系统 PATH（推荐）" />
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="InstallButton" Width="110" Height="36" Margin="0,0,16,0" Content="安装" Click="InstallButton_Click" />
                <Button Width="100" Height="36" Content="取消" Click="CancelButton_Click" />
            </StackPanel>
        </Grid>

        <Grid x:Name="MaintenancePanel" Grid.Row="1" Margin="0,58,0,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="维护" FontSize="36" Foreground="#FF666666" />
            <TextBlock Grid.Row="1" Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="PictureTransformer 已安装。你可以修复现有安装或将其卸载。" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="110" Height="36" Margin="0,0,16,0" Content="修复" Click="RepairButton_Click" />
                <Button Width="110" Height="36" Margin="0,0,16,0" Content="卸载" Click="UninstallButton_Click" />
                <Button Width="100" Height="36" Content="取消" Click="CancelButton_Click" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ProgressPanel" Grid.Row="1" Margin="0,58,0,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="ProgressHeader" Text="正在安装" FontSize="36" Foreground="#FF666666" />
            <TextBlock x:Name="ProgressText" Grid.Row="1" Margin="0,18,0,12" Text="正在准备…" />
            <ProgressBar x:Name="InstallProgressBar" Grid.Row="2" Height="18" Minimum="0" Maximum="100" />
        </Grid>

        <Grid x:Name="ResultPanel" Grid.Row="1" Margin="0,58,0,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="ResultHeader" FontSize="36" Foreground="#FF666666" />
            <TextBlock x:Name="ResultText" Grid.Row="1" Margin="0,18,0,0" TextWrapping="Wrap" />
            <Button Grid.Row="3" Width="100" Height="36" HorizontalAlignment="Right" Content="关闭" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
