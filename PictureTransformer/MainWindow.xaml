<Window x:Class="PictureTransformer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Title="PictureTransformer" Width="1200" Height="820"
        MinWidth="1100" MinHeight="820" WindowStartupLocation="CenterScreen"
        Icon="Assets/png.png"
        Background="#F6F8FC" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#604FF2" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#5140DC" />
        <SolidColorBrush x:Key="TextBrush" Color="#1A2133" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#7A8192" />
        <SolidColorBrush x:Key="FieldBrush" Color="#F7F8FB" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E2EA" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="16,10" />
            <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#30364A" /><Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" /><Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F5F4FF" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="44" /><Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
                <Ellipse Fill="White" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2" />
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="CompressionSliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="60" /><Setter Property="Height" Value="18" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid>
                <Border Height="6" VerticalAlignment="Center" Background="#DDE0E9" CornerRadius="3" />
                <Track x:Name="PART_Track" VerticalAlignment="Center" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                       Value="{TemplateBinding Value}" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton><RepeatButton Background="{StaticResource PrimaryBrush}" BorderThickness="0" Command="{x:Static Slider.DecreaseLarge}" /></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource SliderThumbStyle}" /></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Background="#DDE0E9" BorderThickness="0" Command="{x:Static Slider.IncreaseLarge}" /></Track.IncreaseRepeatButton>
                </Track>
            </Grid></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid MinWidth="1100" MinHeight="760">
        <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Height="76" Background="White" HorizontalAlignment="Stretch">
            <Grid Margin="28,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Width="36" Height="36" Source="Assets/png.png" Stretch="Uniform" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PictureTransformer" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="Bold" />
                    <TextBlock Text="IMAGE WORKSPACE" Foreground="#8990A0" FontSize="9" FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel></Grid>
        </Border>

        <Grid Grid.Row="1" Margin="32,30">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="转换你的图片" Foreground="{StaticResource TextBrush}" FontSize="30" FontWeight="Bold" />
                    <TextBlock Margin="0,6,0,0" Text="批量调整格式与压缩率，几秒钟完成。" Foreground="{StaticResource MutedTextBrush}" FontSize="13" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddFolderCommand}" Content="□  选择文件夹" />
                    <Button Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddImagesCommand}" Content="＋  添加图片" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="416" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="250" />
                            <RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="添加图片" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="Bold" />
                        <TextBlock Grid.Row="1" Margin="0,8,0,16" Text="支持 JPG、PNG、WEBP、HEIC 等常见格式" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        <Border Grid.Row="2" Background="#FAF9FF" BorderBrush="#C8C0FF" BorderThickness="1" CornerRadius="14"
                                AllowDrop="True" DragOver="DropZone_OnDragOver" Drop="DropZone_OnDrop" MouseLeftButtonUp="DropZone_OnMouseLeftButtonUp" Cursor="Hand">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="64" Height="64" Background="#E3DEFF" CornerRadius="32">
                                    <TextBlock Text="↑" Foreground="{StaticResource PrimaryBrush}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Margin="0,12,0,0" Text="拖拽图片到这里" Foreground="#30364A" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Margin="0,7,0,0" Text="或点击此区域选择多个图片" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="4" Orientation="Horizontal">
                            <TextBlock Text="转换队列" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="Bold" />
                            <TextBlock Margin="8,1,0,0" Text="{Binding QueueCountText}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        </StackPanel>
                        <Border Grid.Row="6" Background="#F7F8FB" CornerRadius="10" Padding="12" ClipToBounds="True">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding Queue}" Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid Height="38" ToolTip="{Binding Path}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" Background="#E8E5FF" CornerRadius="7"><TextBlock Text="图" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" /></Border>
                                            <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="#3D4353" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Details}" Foreground="#8B91A0" FontSize="9" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource PrimaryBrush}" FontSize="10" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasFiles}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <TextBlock Text="还没有添加图片" Foreground="#4D5363" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Margin="0,3,0,0" Text="添加后会显示在这里" Foreground="#8B91A0" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="48" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="转换设置" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="Bold" />
                        <TextBlock Grid.Row="1" Margin="0,8,0,18" Text="选择输出规则" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="输出格式" Foreground="#3D4353" FontSize="12" FontWeight="SemiBold" />
                            <ComboBox Margin="0,8,0,18" Height="44" Padding="10,0" BorderThickness="0" Background="{StaticResource FieldBrush}"
                                      ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding SelectedOutputFormat}" IsEnabled="{Binding CanEditSettings}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3">
                            <Grid><TextBlock Text="压缩率" Foreground="#3D4353" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CompressionText}" Foreground="{StaticResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Margin="0,10,0,18" Style="{StaticResource CompressionSliderStyle}" Value="{Binding Compression}"
                                    IsEnabled="{Binding IsCompressionEnabled}" TickFrequency="1" IsSnapToTickEnabled="True" />
                        </StackPanel>
                        <StackPanel Grid.Row="4">
                            <TextBlock Text="输出目录" Foreground="#3D4353" FontSize="12" FontWeight="SemiBold" />
                            <Button Margin="0,8,0,0" Style="{StaticResource FieldButtonStyle}" Command="{Binding SelectOutputDirectoryCommand}">
                                <Grid><TextBlock Text="⌂" Foreground="{StaticResource PrimaryBrush}" FontSize="15" VerticalAlignment="Center" />
                                    <TextBlock Margin="24,0,0,0" Text="{Binding OutputDirectoryText}" Foreground="#4B5161" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Button>
                            <TextBlock Margin="2,8,0,0" Text="未选择时，每张图片输出到其源文件旁边" Foreground="#8B91A0" FontSize="10" />
                        </StackPanel>
                        <Button Grid.Row="6" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ConvertCommand}" HorizontalContentAlignment="Center" Content="→  开始转换" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
